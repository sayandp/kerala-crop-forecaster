# Copy to .env and fill in. Never commit .env.
ENV=local

# Postgres (docker-compose default shown)
DATABASE_URL=postgresql+psycopg://cropcast:cropcast@localhost:5432/cropcast

# data.gov.in — get a key at https://data.gov.in (My Account → API key)
DATAGOV_API_KEY=
# Optional override; defaults to the "Current Daily Price of Various Commodities" resource
# DATAGOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# MLflow (DagsHub in prod; local docker-compose server shown)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Tests only: a throwaway DB (tests truncate tables)
TEST_DATABASE_URL=postgresql+psycopg://cropcast:cropcast@localhost:5432/cropcast_test
